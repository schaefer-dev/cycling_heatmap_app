# Copy to .env and fill in. GARMIN_API_KEY enables the Garmin sync, HAMMERHEAD_CLIENT_ID +
# HAMMERHEAD_CLIENT_SECRET the Hammerhead sync; both are optional.

# Garmin Connect → Settings → Personal API token. Keys expire (30 days … 1 year);
# the UI shows an error when it has expired: create a new one and replace it here.
GARMIN_API_KEY=

# Minutes between automatic Garmin syncs (0 = only "Sync now").
# GARMIN_SYNC_INTERVAL_MIN=60

# Hammerhead dashboard → Settings → API settings. After restarting, click "Connect Hammerhead".
HAMMERHEAD_CLIENT_ID=
HAMMERHEAD_CLIENT_SECRET=
# Must exactly match a redirect URL registered in the dashboard, at the address you open the app.
# HAMMERHEAD_REDIRECT_URI=http://localhost:5173/api/hammerhead/callback
# Minutes between automatic Hammerhead syncs (0 = only "Sync now").
# HAMMERHEAD_SYNC_INTERVAL_MIN=60
# Webhooks are not used (the Pi is not reachable from the internet); kept for later.
# HAMMERHEAD_WEBHOOK_SECRET=

# Route grouping: share of each ride that must lie within the tolerance of the other.
# Changing these only affects new rides until you run `npm run routes:rebuild`.
# ROUTE_MATCH_THRESHOLD=0.9
# ROUTE_MATCH_TOLERANCE_M=40

# Route names from OpenStreetMap place names (Nominatim). Set to false to disable.
# GEOCODER_ENABLED=true
# GEOCODER_LANGUAGE=de

# Paths / server
# PORT=3001
# DATA_DIR=./data            # database, backups/, fit/ (raw Garmin + Hammerhead files)
# DB_PATH=./data/cycling_archive.db
# TZ_NAME=Europe/Berlin      # for ride dates of GPX uploads; defaults to the system zone
# LOG_LEVEL=info
