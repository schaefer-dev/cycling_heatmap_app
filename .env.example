# Copy to .env and fill in. Only GARMIN_API_KEY is required for Garmin sync.

# Garmin Connect → Settings → Personal API token. Keys expire (30 days … 1 year);
# the UI shows an error when it has expired: create a new one and replace it here.
GARMIN_API_KEY=

# Minutes between automatic Garmin syncs (0 = only "Sync now").
# GARMIN_SYNC_INTERVAL_MIN=60

# Route grouping: share of each ride that must lie within the tolerance of the other.
# Changing these only affects new rides until you run `npm run routes:rebuild`.
# ROUTE_MATCH_THRESHOLD=0.9
# ROUTE_MATCH_TOLERANCE_M=40

# Route names from OpenStreetMap place names (Nominatim). Set to false to disable.
# GEOCODER_ENABLED=true
# GEOCODER_LANGUAGE=de

# Paths / server
# PORT=3001
# DATA_DIR=./data            # database, backups/, fit/ (raw Garmin files)
# DB_PATH=./data/cycling_archive.db
# TZ_NAME=Europe/Berlin      # for ride dates of GPX uploads; defaults to the system zone
# LOG_LEVEL=info
