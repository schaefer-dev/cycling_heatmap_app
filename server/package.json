  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../.env src/main.ts",
    "start": "node --env-file-if-exists=../.env src/main.ts",
    "typecheck": "tsc -p tsconfig.json",
    "routes:rebuild": "node --env-file-if-exists=../.env src/cli/routes-rebuild.ts",
    "routes:evaluate": "node --env-file-if-exists=../.env src/cli/routes-evaluate.ts",
    "garmin:sync": "node --env-file-if-exists=../.env src/cli/garmin-sync.ts",
    "hammerhead:sync": "node --env-file-if-exists=../.env src/cli/hammerhead-sync.ts",
    "hammerhead:routes": "node --env-file-if-exists=../.env src/cli/hammerhead-routes.ts"
  },
  "dependencies": {
    "@garmin/fitsdk": "^21.218.0",
    "better-sqlite3": "^12.5.0",
    "compression": "^1.8.2",
    "express": "^5.2.1",
    "fast-xml-parser": "^5.3.3",
    "fflate": "^0.8.3",
    "multer": "^2.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1"
  }
}
