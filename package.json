{
  "name": "ridestack",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted cycling archive: Garmin and Hammerhead sync, automatic route grouping and a personal heatmap",
  "license": "AGPL-3.0-only",
  "author": "Daniel Schäfer",
  "homepage": "https://github.com/schaefer-dev/ridestack#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/schaefer-dev/ridestack.git"
  },
  "bugs": "https://github.com/schaefer-dev/ridestack/issues",
  "keywords": [
    "cycling",
    "heatmap",
    "garmin",
    "hammerhead",
    "karoo",
    "gpx",
    "fit",
    "self-hosted",
    "raspberry-pi",
    "leaflet"
  ],
  "workspaces": [
    "server",
    "client"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"npm run dev -w server\" \"npm run dev -w client\"",
    "server": "npm run dev -w server",
    "client": "npm run dev -w client",
    "serve": "concurrently -k -n server,client -c blue,green \"npm run start -w server\" \"npm run dev -w client -- --host\"",
    "build": "npm run build -w client",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm run test",
    "demo:seed": "npm run demo:seed -w server --",
    "routes:rebuild": "npm run routes:rebuild -w server --",
    "routes:evaluate": "npm run routes:evaluate -w server --",
    "bikes:classify": "npm run bikes:classify -w server --",
    "garmin:sync": "npm run garmin:sync -w server --",
    "hammerhead:sync": "npm run hammerhead:sync -w server --",
    "hammerhead:routes": "npm run hammerhead:routes -w server --",
    "pi:push": "scripts/sync_to_pi.sh",
    "pi:pull": "scripts/sync_from_pi.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^9.2.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "better-sqlite3": true,
    "esbuild": true,
    "fsevents": false
  }
}
